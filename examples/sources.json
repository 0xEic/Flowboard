          "id": "note-1",
          "type": "Note",
          "config": {
            "text": "A Timer emits a true pulse on its tick output every intervalMs milliseconds (once if repeat is off), with start/reset inputs to control its run state and isRunning/timeLeft/timePast outputs reporting status and per-interval progress."
          },
          "position": {
            "x": 930.4235082282388,
            "y": 271.00561606625575
          },
          "width": 324,
          "height": 108
        },
        {
          "id": "note-2",
          "type": "Note",
          "config": {
            "text": "Random emits a random value of the configured type on each trigger (min/max for numbers, length + character classes for strings, probability for Bool)."
          },
          "position": {
            "x": 1428.661687241592,
            "y": 187.17506531162812
          }
        },
        {
          "id": "note-3",
          "type": "Note",
          "config": {
            "text": "Iterator steps a value from startValue to endValue by stepSize at a timed cadence, optionally looping or sweeping back and forth (a ramp/sweep generator)."
          },
          "position": {
            "x": 936.5335545551034,
            "y": 1399.0787600398892
          },
          "width": 408,
          "height": 78
        },
        {
          "id": "note-4",
          "type": "Note",
          "config": {
            "text": "CurrentTime emits the current time whenever 'trigger' fires, typed per the configured unit (epoch ms/s as Int64, or a formatted String). "
          },
          "position": {
            "x": 1874.2171097854307,
            "y": 798.6250662955028
          },
          "width": 223,
          "height": 97
        },
        {
          "id": "note-5",
          "type": "Note",
          "config": {
            "text": "ConstantSource emits a fixed configured primitive value on 'trigger' (and once on init when auto-trigger is on)."
          },
          "position": {
            "x": 1864.6087506574243,
            "y": 1144.4740602242082
          },
          "width": 229,
