          }
        },
        {
          "id": "note-python",
          "type": "Note",
          "position": {
            "x": 794.7715015361914,
            "y": 434.67499290620356
          },
          "width": 320,
          "height": 150,
          "config": {
            "text": "Python.Script with STRUCT I/O. The input port 'rate_in' and output port 'rate_out' are typed M_Mount::ScaledRateType. on_input(port, value) receives the struct as a Python dict of plain numbers; call emit('rate_out', {...}) with the same field keys to send a struct back out. Built-in scalars (Double/Int64/...) or any OnboardAPI struct tag work as port types."
          }
        }
      ],
