            "autostart": true,
            "endValue": -30,
            "loop": true,
            "specialEndEndValue": "linear",
            "specialEndStartValue": "linear",
            "specialStartEndValue": "linear",
            "specialStartStartValue": "linear",
            "startValue": 0,
            "stepSize": 2,
            "timeBetweenStepsMs": 200,
            "valueType": "flowboard::Double"
          }
        },
        {
          "id": "factory",
          "type": "Factory.M_Mount::ScaledRateType",
          "position": {
            "x": 460,
            "y": 240
          },
          "config": {
            "AzimuthScaledRate": 0,
            "ElevationScaledRate": 0,
            "autoTriggerOnNewInput": true
          }
        },
        {
          "id": "py",
          "type": "Python.Script",
          "position": {
            "x": 828.3429215265166,
            "y": 241.6962428605795
          },
          "config": {
            "inputs": [
              {
                "name": "rate_in",
                "type": "M_Mount::ScaledRateType"
              }
            ],
            "outputs": [
              {
                "name": "rate_out",
                "type": "M_Mount::ScaledRateType"
              }
            ],
            "pythonExe": "",
            "script": "GAIN = 1.5\nLIMIT = 60.0\n\ndef _clamp(x):\n    if x >  LIMIT: return  LIMIT\n    if x < -LIMIT: return -LIMIT\n    return x\n\ndef on_input(port, value):\n    if port == 'rate_in':\n        # value is the struct as a dict of plain numbers\n        az = value.get('AzimuthScaledRate', 0.0)\n        el = value.get('ElevationScaledRate', 0.0)\n        emit('rate_out', {\n            'AzimuthScaledRate':   _clamp(az * GAIN),\n            'ElevationScaledRate': _clamp(el * GAIN),\n        })\n"
          }
        },
        {
          "id": "log-struct",
          "type": "Sinks.Log",
          "position": {
            "x": 1211.5971144712946,
            "y": 138.30375713942047
          },
          "config": {
            "inputType": "M_Mount::ScaledRateType",
            "prefix": "scaled-rate"
          }
        },
        {
          "id": "display-struct",
          "type": "Debug.ValueDisplay",
          "position": {
            "x": 1222.6226930650616,
            "y": 277.4556357091307
          },
          "width": 260,
          "height": 130,
          "config": {
            "inputType": "M_Mount::ScaledRateType",
            "fields": [
              "AzimuthScaledRate",
