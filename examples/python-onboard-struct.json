{
  "version": "1.0",
  "metadata": {
    "name": "python-onboard-struct",
    "description": "A Python.Script node whose input AND output ports are an OnboardAPI struct datatype (M_Mount::ScaledRateType). Two Iterator ramps feed a Factory.M_Mount::ScaledRateType that assembles the struct; Python receives it as a dict, applies a gain + clamp to both fields, and emits a struct back; the result is logged whole, shown field-by-field, and one field is extracted to a plot. Requires python on PATH; the M_Mount struct types are compiled into the binary.",
    "authoring": {
      "version": "1.0",
      "metadata": {
        "name": "python-onboard-struct",
        "description": "A Python.Script node whose input AND output ports are an OnboardAPI struct datatype (M_Mount::ScaledRateType). Two Iterator ramps feed a Factory.M_Mount::ScaledRateType that assembles the struct; Python receives it as a dict, applies a gain + clamp to both fields, and emits a struct back; the result is logged whole, shown field-by-field, and one field is extracted to a plot. Requires python on PATH; the M_Mount struct types are compiled into the binary."
      },
      "nodes": [
        {
          "id": "iter-az",
          "type": "Sources.Iterator",
          "position": {
            "x": 31.74071931427693,
