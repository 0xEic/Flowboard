{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flowboard Graph",
  "type": "object",
  "required": ["version", "nodes", "edges"],
  "properties": {
    "version":  { "type": "string", "const": "1.0" },
    "metadata": {
      "type": "object",
      "properties": {
        "name":        { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id":       { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "type":     { "type": "string" },
          "position": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            },
            "additionalProperties": false
          },
          "config":   { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from":     { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*\\.[A-Za-z][A-Za-z0-9_]*$" },
          "to":       { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*\\.[A-Za-z][A-Za-z0-9_]*$" },
          "capacity": { "type": "integer", "minimum": 1, "maximum": 65536 },
          "policy":   { "enum": ["block", "drop_oldest"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
